# Lokal (PGlite via `npm run db:local`):
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/postgres
DB_POOL_MAX=1
# Produksi (Neon): gunakan connection string "pooled", contoh:
# DATABASE_URL=postgres://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Dipakai `npm run db:seed` untuk membuat admin pertama
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti-password-ini
ADMIN_NAME=Administrator
